{
	admin off
}

:{$PORT:8080} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy {$API_URL}
	}

	handle /assets/* {
		root * /srv
		@existingAsset file
		header @existingAsset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
