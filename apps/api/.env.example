NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://app:dev_only_password@localhost:5432/customer_support_logistics
# Password db:seed gives to the seeded agents, 12 characters or more
# SEED_AGENT_PASSWORD=change-me-local-only
# Code that logs in any customer while Vonage is disabled, 4 to 10 digits
# DEV_VERIFY_CODE=123456
# Your own phone, to log in as a seeded customer with a real SMS. Local .env only
# SEED_CUSTOMER_PHONES=+34600000000
# PWA page Verify returns to after silent authentication. Unset: customers log in by SMS only
# SILENT_AUTH_REDIRECT_URL=https://your-pwa.example/login/callback
REDIS_URL=redis://localhost:6379

# SeaweedFS S3 defaults from docker-compose.yml. Do not use these credentials outside development.
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=evidence
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=dev_only_seaweedfs_secret
STORAGE_FORCE_PATH_STYLE=true
EVIDENCE_IMAGE_MAX_BYTES=10485760
EVIDENCE_VIDEO_MAX_BYTES=52428800
EVIDENCE_MAX_FILES_PER_INCIDENT=5
EVIDENCE_UPLOAD_URL_TTL_SECONDS=900
EVIDENCE_PENDING_TTL_SECONDS=3600
EVIDENCE_DOWNLOAD_URL_TTL_SECONDS=300

VONAGE_ENABLED=false
# PUBLIC_URL=https://your-subdomain.ngrok-free.app
# VONAGE_API_KEY=your-vonage-api-key
# VONAGE_API_SECRET=your-vonage-api-secret
# VONAGE_APPLICATION_ID=your-vonage-application-id
# VONAGE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# VONAGE_VIRTUAL_NUMBER=+34600000000
# VONAGE_SIGNATURE_SECRET=your-vonage-signature-secret

WEBHOOK_RATE_LIMIT_PER_MINUTE=120
# Header with the client IP, only behind a proxy that sets it (x-real-ip on Railway)
# CLIENT_IP_HEADER=x-real-ip
