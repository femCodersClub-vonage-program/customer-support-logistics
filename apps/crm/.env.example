# API base URL (default: http://localhost:3000). Server-side requests read it at runtime,
# and the /api rewrites at build time, so a production build needs it set.
API_URL=http://localhost:3000

# Temporary, until the real login ([1.5]). Agent id sent as the x-dev-actor header.
# Default: seeded agent A.
DEV_AGENT_ID=5eed0000-0000-4000-8000-0000000000a1